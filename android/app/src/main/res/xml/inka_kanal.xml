<?xml version="1.0" encoding="utf-8"?>
<!-- Eigener Lautstärkekanal für die Sprachspur der Shows (Josef 9.11.2026: "Musik und Sprache getrennt regeln").
     Der Dienst liest keine Fensterinhalte und reagiert auf keine Ereignisse; er schaltet nur die Bedienungshilfen-Lautstärke frei. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAnnouncement"
    android:accessibilityFeedbackType="feedbackAudible"
    android:accessibilityFlags="flagEnableAccessibilityVolume"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="5000"
    android:description="@string/kanal_beschreibung"
    android:summary="@string/kanal_kurz" />
