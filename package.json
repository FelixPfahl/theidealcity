{
  "name": "atelier-folien",
  "productName": "Atelier Folien",
  "version": "1.0.0",
  "description": "Folien am Notebook zeigen, mit Pult koppeln, Dokumentenkamera",
  "author": "Josef",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "de.theidealcity.atelier.folien",
    "productName": "Atelier Folien",
    "files": [
      "main.js",
      "preload.js",
      "start.html",
      "icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atelier Folien",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "de_DE"
      ],
      "language": "1031",
      "artifactName": "Atelier-Folien-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "FelixPfahl",
        "repo": "theidealcity",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "Atelier-Folien-ohne-Installation.${ext}"
    }
  }
}