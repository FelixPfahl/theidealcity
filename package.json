{
  "name": "atelier-folien",
  "productName": "Atelier Folien",
  "version": "1.0.0",
  "description": "Folien am Notebook zeigen, mit Pult koppeln, Dokumentenkamera",
  "author": "Josef",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "de.theidealcity.atelier.folien",
    "productName": "Atelier Folien",
    "files": ["main.js", "preload.js", "start.html", "icon.png"],
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "artifactName": "Atelier-Folien-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atelier Folien",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "FelixPfahl",
        "repo": "theidealcity",
        "releaseType": "release"
      }
    ]
  }
}
